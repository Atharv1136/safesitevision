# SafeSite Vision Environment Configuration
# Database Connection (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=safesitevision
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/safesitevision

# Security
SECRET_KEY=safesite_vision_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=storage/evidence

# Inference
DEVICE=cuda:0
YOLO_MODEL_PATH=models/ppe-yolo11s-v1.0/best.pt
DEFAULT_CONF_THRESHOLD=0.50

# Server
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
DEBUG=true
